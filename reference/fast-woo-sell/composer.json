{
	"name": "fast-woo-sell/fast-woo-sell",
	"description": "Smart product recommendations, abandoned cart follow-up and stock forecasting for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "1.0.0",
		"php-stubs/woocommerce-stubs": "^9.0",
		"php-stubs/wp-cli-stubs": "^2.10",
		"phpcompatibility/phpcompatibility-wp": "2.1.5",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "9.6.20",
		"squizlabs/php_codesniffer": "3.10.2",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "3.1.0",
		"yoast/phpunit-polyfills": "2.0.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml.dist",
		"lint:legacy": "phpcs --standard=phpcs-legacy.xml.dist",
		"lint:all": [
			"@lint",
			"@lint:legacy"
		],
		"fix": "phpcbf --standard=phpcs.xml.dist",
		"test": "phpunit",
		"check": [
			"@lint:all",
			"@analyse",
			"@test"
		],
		"analyse": "phpstan analyse --memory-limit=1G",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	}
}
