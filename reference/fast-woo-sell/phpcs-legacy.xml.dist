<?xml version="1.0"?>
<ruleset name="Fast Woo Sell — legacy parse floor">
	<description>
		The bootstrap and the requirement gate run before the PHP version check,
		so an unsupported PHP version must produce a readable admin notice rather
		than a parse error. Those two files are therefore held to a PHP 5.6 floor.
		Run with: composer lint:legacy
	</description>

	<file>fast-woo-sell.php</file>
	<file>includes/Core/Requirements.php</file>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="5.6-"/>

	<rule ref="PHPCompatibility"/>
</ruleset>
