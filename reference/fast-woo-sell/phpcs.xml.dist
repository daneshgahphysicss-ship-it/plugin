<?xml version="1.0"?>
<ruleset name="Fast Woo Sell">
	<description>Coding standards for the Fast Woo Sell plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/build/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs.cache"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!--
			Class files use StudlyCaps names to match the PSR-4 style autoloader
			introduced in package 0.2, so the WordPress file naming rules do not
			apply to this project.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="fast-woo-sell"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="fws,FWS"/>
		</properties>
	</rule>

	<!--
		Everything is checked against PHP 7.4 and up. The bootstrap and the
		requirement gate additionally have to parse on PHP 5.6, which is
		enforced by the separate phpcs-legacy.xml.dist ruleset.
	-->
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
